{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clockwork",
  "version": "1.0.7",
  "identifier": "com.clockwork",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clockwork",
        "width": 440,
        "height": 640,
        "minWidth": 440,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "backgroundColor": "#040a13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
